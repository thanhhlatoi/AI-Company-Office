# true   = dùng dữ liệu giả hoàn toàn (không gọi BE)
# false  = mọi thứ gọi BE thật (nhiều màn sẽ lỗi vì BE chưa có hết endpoint)
# hybrid = endpoint BE đã có gọi BE thật (agent, goal, task, approval, hệ thống, Hermes), còn lại dùng mock
VITE_USE_MOCK=hybrid
# BE AgentOffice: lớp /api/fe trả đúng hợp đồng của FE
VITE_API_BASE_URL=http://localhost:8082/api/fe
VITE_WS_URL=ws://localhost:8082/ws
# Khoa API cua BE: trung AGENTOFFICE_API_KEY ben BE
VITE_API_KEY=
